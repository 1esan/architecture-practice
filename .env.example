# Optional local adapter configuration. No secrets belong in this file.
# Apply in your shell before starting Python (this app does not auto-load .env):
# set -a; source .env; set +a
ARCH_TRAINER_PORT=8784
TRAINER_MODEL=gpt-6-luna
TRAINER_ADAPTER_URL=http://127.0.0.1:8766
TRAINER_ADAPTER_KEY_FILE=.state/adapter-key
# Optional: ARCH_TRAINER_DB=.state/practice.sqlite3
